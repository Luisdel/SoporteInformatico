# Servidor
APP_HOST=0.0.0.0
APP_PORT=8000

# Datos
DB_PATH=data/incidencias.db
UPLOAD_DIR=data/uploads

# Zona horaria de presentación (la base siempre guarda UTC)
TIMEZONE=Europe/Madrid

# Proxies de confianza para aceptar X-Forwarded-For (CIDR separados por comas)
TRUSTED_PROXIES=

# TLS opcional
TLS_CERT=
TLS_KEY=

# Sesiones y seguridad
SESSION_HOURS=12
MAX_UPLOAD_MB=5
SECURE_COOKIES=0
PBKDF2_ITERATIONS=600000
RESOLVE_HOSTNAMES=1
