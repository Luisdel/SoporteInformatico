# Servidor
# APP_HOST/APP_PORT se usan si arrancas la app por tu cuenta; con Uvicorn en
# systemd el host y el puerto se pasan en ExecStart.
APP_HOST=127.0.0.1
APP_PORT=8000

# Datos (rutas relativas al directorio de trabajo de la app)
DB_PATH=data/incidencias.db
UPLOAD_DIR=data/uploads

# Zona horaria para utilidades locales. La interfaz usa siempre GFH en UTC.
TIMEZONE=Europe/Madrid

# Proxies de confianza para aceptar X-Forwarded-For (CIDR separados por comas).
# Detrás de Nginx en la misma máquina: 127.0.0.1/32
TRUSTED_PROXIES=

# TLS directo opcional (si no usas Nginx)
TLS_CERT=
TLS_KEY=

# Sesiones y seguridad
SESSION_HOURS=12
MAX_UPLOAD_MB=5
SECURE_COOKIES=0
PBKDF2_ITERATIONS=600000
RESOLVE_HOSTNAMES=1
